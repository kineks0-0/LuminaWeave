{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "lib": ["ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../luminaweave-extension/shared/*"],
      "ai": ["./node_modules/ai"],
      "@ai-sdk/*": ["./node_modules/@ai-sdk/*"]
    }
  },
  "include": ["src/**/*.ts", "../luminaweave-extension/shared/**/*.ts"]
}
